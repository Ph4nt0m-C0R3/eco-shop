# Copy into a private environment file on the target host; fill actual values.
APP_NAME="EcoShop v2.0"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://__REPLACE_DOMAIN__.invalid
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecoshop
DB_USERNAME=ecoshop_app
DB_PASSWORD=__REPLACE_DATABASE_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_COOKIE=ecoshop_session
ADMIN_SESSION_COOKIE=ecoshop_admin_session

CACHE_STORE=database
CACHE_PREFIX=ecoshop
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Direct Nginx TLS needs no proxy trust. Add actual load-balancer IPs/CIDRs if used.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=__REPLACE_MAIL_HOST__
MAIL_PORT=587
MAIL_USERNAME=__REPLACE_MAIL_USERNAME__
MAIL_PASSWORD=__REPLACE_MAIL_PASSWORD__
MAIL_TIMEOUT=15
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=__REPLACE_FROM_ADDRESS__
MAIL_FROM_NAME="EcoShop v2.0"

# Enter each provider's registered HTTPS callback URL, client ID and secret privately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://__REPLACE_DOMAIN__.invalid/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://__REPLACE_DOMAIN__.invalid/auth/github/callback

# Enable payment providers only after account/currency verification.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
